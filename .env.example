# OpenAI API Configuration for AetherSDLC Agents
# Enter your OpenAI API key below to enable dynamic LLM agent reasoning:
OPENAI_API_KEY=your_openai_api_key_here

# Model name (default: gpt-4o-mini, or gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Production Infrastructure Connections (Optional overrides for Docker / Cloud)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://aetheruser:aetherpass_secure@localhost:5432/aethersdlc

